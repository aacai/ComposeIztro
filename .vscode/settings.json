{
  "terminal.integrated.env.osx": {
    "JAVA_HOME": "/Applications/Android Studio.app/Contents/jbr/Contents/Home"
  },
  "terminal.integrated.env.windows": {
    "JAVA_HOME": "${env:JAVA_HOME}"
  },
  "terminal.integrated.env.linux": {
    "JAVA_HOME": "${env:JAVA_HOME}"
  },
  "gradle.reuseTerminal": true,
  "gradle.focusTaskInExplorer": true,

  "kotlin.languageServer.enabled": true,
  "kotlin.languageServer.script.compiler.jvm.target": "17",
  "kotlin.trace.server": "off",
  "kotlin.compiler.jvm.target": "17",
  "kotlin.diagnostics.enabled": false,
  "kotlin.indexing.enabled": true,
  "[kotlin]": {
    "editor.defaultFormatter": "fwcd.kotlin",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },

  "java.import.exclusions": [
    "**/build",
    "**/shared",
    "**/androidApp",
    "**/desktopApp",
    "**/webApp"
  ],
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.server.launchMode": "Standard",

  "files.watcherExclude": {
    "**/build/**": true,
    "**/.gradle/**": true,
    "**/.kotlin/**": true
  },
  "files.exclude": {
    "**/build": true,
    "**/.gradle": true,
    "**/.kotlin": true,
    "**/.idea": true
  },
  "search.exclude": {
    "**/build": true,
    "**/.gradle": true,
    "**/.kotlin": true
  },

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
